---
import 'photoswipe/style.css';
import Base from '../../../layouts/Base.astro';
import { GISCUS } from '../../../config';
import { embedFlickrPhotos, getPhoto, srcset } from '../../../lib/flickr';
import { formatDate, getPosts, withBase, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { year: post.year, month: post.month, slug: post.slug },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, date, place, draft } = post.entry.data;
const html = await embedFlickrPhotos(post.entry.rendered?.html ?? '');
const cover = post.coverId ? await getPhoto(post.coverId) : undefined;
const nextCover = next?.coverId ? await getPhoto(next.coverId) : undefined;
const giscusEnabled = Object.values(GISCUS).every(Boolean);
const globeLink = withBase(`/?post=${encodeURIComponent(post.url)}`);
const coverTransition = (p: Post) => `view-transition-name: cover-${p.entry.id.replace(/[^a-z0-9-]/gi, '-')}`;
---

<Base title={title} description={`Dag ${post.day} in ${place}, ${formatDate(date)}`} image={cover?.thumb.src}>
  <header class:list={['hero', { 'has-cover': cover }]}>
    {cover && <img src={cover.large.src} srcset={srcset(cover)} sizes="100vw" width={cover.large.width} height={cover.large.height} alt={cover.alt} fetchpriority="high" style={coverTransition(post)} />}
    <nav class="top">
      <a href={globeLink} class="back" aria-label="Terug naar de kaart" title="Terug naar de kaart">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
      </a>
    </nav>
    <div class="hero-text">
      <p class="day">Dag {post.day} in {place}</p>
      <h1>{title}</h1>
      <p class="date">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        {draft && <strong>, concept</strong>}
      </p>
    </div>
  </header>
  <article class="body" set:html={html} />
  {
    giscusEnabled && (
      <section class="comments" aria-label="Reacties">
        <h2>Reacties</h2>
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping="pathname"
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="light"
          data-lang="nl"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </section>
    )
  }
  <nav class="pager" aria-label="Andere posts">
    {
      next && (
        <a href={next.url} class="next">
          {nextCover && <img src={nextCover.thumb.src} srcset={srcset(nextCover, 1024)} sizes="(min-width: 36rem) 33.5rem, calc(100vw - 2.5rem)" alt="" loading="lazy" decoding="async" style={coverTransition(next)} />}
          <span class="next-label">Volgende: dag {next.day} in {next.entry.data.place}</span>
          <span class="next-title">{next.entry.data.title}</span>
        </a>
      )
    }
    {prev && <a href={prev.url} class="prev">Vorige: {prev.entry.data.place}</a>}
  </nav>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.body',
    children: 'figure.photo > a',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'flickr-link',
      order: 8,
      isButton: false,
      tagName: 'a',
      html: 'Flickr ↗',
      onInit: (el, pswp) => {
        el.setAttribute('target', '_blank');
        el.setAttribute('rel', 'noopener');
        pswp.on('change', () => {
          const page = pswp.currSlide?.data.element?.dataset.flickrPage;
          if (page) el.setAttribute('href', page);
        });
      },
    });
  });
  lightbox.init();

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('shown');
          reveal.unobserve(entry.target);
        }
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll('.body figure.photo').forEach((photo) => {
      if (photo.getBoundingClientRect().top < innerHeight) return;
      photo.classList.add('reveal');
      reveal.observe(photo);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: space-between;
    max-width: 60rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 0;
  }

  .hero.has-cover {
    max-width: none;
    min-height: min(85svh, 52rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
    color: var(--paper);
    background: var(--ink);
  }

  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero.has-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(27 31 26 / 0.45), transparent 25%, transparent 45%, rgb(27 31 26 / 0.85));
  }

  .top,
  .hero-text {
    position: relative;
    z-index: 1;
  }

  .back {
    position: fixed;
    top: max(1rem, env(safe-area-inset-top));
    left: max(1rem, env(safe-area-inset-left));
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.6rem 0.9rem 0.6rem 0.7rem;
    border: 1px solid rgb(243 238 228 / 0.18);
    border-radius: 999px;
    background: rgb(27 31 26 / 0.82);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgb(27 31 26 / 0.25);
    color: var(--paper);
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .back:hover,
  .back:focus-visible {
    background: var(--paper);
    color: var(--ink);
  }

  .back:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--paper);
  }

  .hero-text,
  .body > :global(:nth-child(-n + 2)) {
    animation: rise 300ms ease-out both;
  }

  .body > :global(:nth-child(-n + 2)) {
    animation-delay: 100ms;
  }

  .body :global(figure.photo.reveal) {
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 250ms ease-out,
      translate 250ms ease-out;
  }

  .body :global(figure.photo.reveal.shown) {
    opacity: 1;
    translate: none;
  }

  .hero-text {
    max-width: 48rem;
    margin-top: clamp(3rem, 10vw, 6rem);
  }

  .has-cover .hero-text {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  .day {
    margin: 0 0 0.5rem;
    color: var(--verm-tekst);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    font-style: italic;
  }

  .has-cover .day {
    color: inherit;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .date {
    margin: 1rem 0 0;
    color: var(--mute);
  }

  .has-cover .date {
    color: inherit;
    opacity: 0.85;
  }

  .body {
    display: grid;
    grid-template-columns: 1fr min(36rem, 100% - 2.5rem) 1fr;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    font-size: 1.2rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .body > :global(*) {
    grid-column: 2;
  }

  .body :global(h2) {
    margin: 2.5rem 0 0.25rem;
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .body :global(ul) {
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: 0.35rem;
  }

  .body :global(ul li::marker) {
    color: var(--verm);
  }

  .body :global(figure.photo),
  .body :global(.photo-row) {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(60rem, 100%);
    margin: 2.5rem 0;
  }

  .body :global(.photo-row) {
    display: flex;
    gap: 0.5rem;
  }

  .body :global(.photo-row figure.photo) {
    width: auto;
    min-width: 0;
    margin: 0;
  }

  .body :global(.photo-row figcaption) {
    padding-inline: 0.5rem;
  }

  .body :global(figure.photo img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--line);
  }

  .body :global(figcaption) {
    color: var(--mute);
    font-size: 0.95rem;
    font-style: italic;
    padding: 0.6rem 1.25rem 0;
  }

  @media (min-width: 62rem) {
    .body :global(figcaption) {
      padding-inline: 0;
    }
  }

  .comments {
    max-width: 36rem;
    margin: 4rem auto 0;
    padding: 0 1.25rem;
  }

  .comments h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 400;
  }

  .pager {
    display: grid;
    gap: 1.5rem;
    max-width: 36rem;
    margin: 4rem auto 0;
    padding: 2rem 1.25rem 4rem;
    border-top: 1px solid var(--line);
  }

  .next {
    display: grid;
    gap: 0.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .next img {
    transition: opacity 150ms ease;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: 0.75rem;
  }

  .next-label {
    color: var(--verm-tekst);
    font-style: italic;
  }

  .next-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .next:hover img {
    opacity: 0.88;
  }

  .next-title {
    text-decoration: underline transparent;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 150ms ease;
  }

  .next:hover .next-title {
    text-decoration-color: currentColor;
  }

  :global(.pswp__flickr-link) {
    color: #fff;
    align-self: center;
    font-size: 0.875rem;
    padding: 0 1rem;
    text-decoration: none;
  }
</style>
