---
import 'photoswipe/style.css';
import Base from '../../../layouts/Base.astro';
import { embedFlickrPhotos, getPhoto } from '../../../lib/flickr';
import { formatDate, getPosts, withBase, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { year: post.year, month: post.month, slug: post.slug },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, date, place, draft } = post.entry.data;
const html = await embedFlickrPhotos(post.entry.rendered?.html ?? '');
const cover = post.coverId ? await getPhoto(post.coverId) : undefined;
const nextCover = next?.coverId ? await getPhoto(next.coverId) : undefined;
const globeLink = withBase(`/?post=${encodeURIComponent(post.url)}`);
---

<Base title={title} description={`Dag ${post.day} in ${place}, ${formatDate(date)}`} image={cover?.thumb.src}>
  <header class:list={['hero', { 'has-cover': cover }]}>
    {cover && <img src={cover.large.src} width={cover.large.width} height={cover.large.height} alt={cover.alt} fetchpriority="high" />}
    <nav class="top">
      <a href={globeLink}>Terug naar de kaart</a>
    </nav>
    <div class="hero-text">
      <p class="day">Dag {post.day} in {place}</p>
      <h1>{title}</h1>
      <p class="date">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        {draft && <strong>, concept</strong>}
      </p>
    </div>
  </header>
  <article class="body" set:html={html} />
  <nav class="pager" aria-label="Andere posts">
    {
      next && (
        <a href={next.url} class="next">
          {nextCover && <img src={nextCover.thumb.src} alt="" loading="lazy" decoding="async" />}
          <span class="next-label">Volgende: dag {next.day} in {next.entry.data.place}</span>
          <span class="next-title">{next.entry.data.title}</span>
        </a>
      )
    }
    {prev && <a href={prev.url} class="prev">Vorige: {prev.entry.data.place}</a>}
  </nav>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.body',
    children: 'figure.photo > a',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'flickr-link',
      order: 8,
      isButton: false,
      tagName: 'a',
      html: 'Flickr ↗',
      onInit: (el, pswp) => {
        el.setAttribute('target', '_blank');
        el.setAttribute('rel', 'noopener');
        pswp.on('change', () => {
          const page = pswp.currSlide?.data.element?.dataset.flickrPage;
          if (page) el.setAttribute('href', page);
        });
      },
    });
  });
  lightbox.init();
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: space-between;
    max-width: 60rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 0;
  }

  .hero.has-cover {
    max-width: none;
    min-height: min(85svh, 52rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
    color: var(--steen);
    background: var(--nachtzee);
  }

  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero.has-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(14 26 36 / 0.45), transparent 25%, transparent 45%, rgb(14 26 36 / 0.85));
  }

  .top,
  .hero-text {
    position: relative;
    z-index: 1;
  }

  .top a {
    color: inherit;
    font-size: 1.05rem;
  }

  .hero-text {
    max-width: 48rem;
    margin-top: clamp(3rem, 10vw, 6rem);
  }

  .has-cover .hero-text {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  .day {
    margin: 0 0 0.5rem;
    color: var(--link);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    font-style: italic;
  }

  .has-cover .day {
    color: var(--oker);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .date {
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .has-cover .date {
    color: inherit;
    opacity: 0.85;
  }

  .body {
    display: grid;
    grid-template-columns: 1fr min(36rem, 100% - 2.5rem) 1fr;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    font-size: 1.2rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .body > :global(*) {
    grid-column: 2;
  }

  .body :global(h2) {
    margin: 2.5rem 0 0.25rem;
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .body :global(ul) {
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: 0.35rem;
  }

  .body :global(li::marker) {
    color: var(--accent);
  }

  .body :global(figure.photo),
  .body :global(.photo-row) {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(60rem, 100%);
    margin: 2.5rem 0;
  }

  .body :global(.photo-row) {
    display: flex;
    gap: 0.5rem;
  }

  .body :global(.photo-row figure.photo) {
    width: auto;
    min-width: 0;
    margin: 0;
  }

  .body :global(.photo-row figcaption) {
    padding-inline: 0.5rem;
  }

  .body :global(figure.photo img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--line);
  }

  .body :global(figcaption) {
    color: var(--muted);
    font-size: 0.95rem;
    font-style: italic;
    padding: 0.6rem 1.25rem 0;
  }

  @media (min-width: 62rem) {
    .body :global(figcaption) {
      padding-inline: 0;
    }
  }

  .pager {
    display: grid;
    gap: 1.5rem;
    max-width: 36rem;
    margin: 4rem auto 0;
    padding: 2rem 1.25rem 4rem;
    border-top: 1px solid var(--line);
  }

  .next {
    display: grid;
    gap: 0.25rem;
    color: var(--fg);
    text-decoration: none;
  }

  .next img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: 0.75rem;
  }

  .next-label {
    color: var(--link);
    font-style: italic;
  }

  .next-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .next:hover .next-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  :global(.pswp__flickr-link) {
    color: #fff;
    align-self: center;
    font-size: 0.875rem;
    padding: 0 1rem;
    text-decoration: none;
  }
</style>
