---
import 'maplibre-gl/dist/maplibre-gl.css';
import Base from '../layouts/Base.astro';
import { ACCENT, HOME, SITE_DESCRIPTION, SITE_DESCRIPTION_ACCENT, SITE_TITLE, SUBSCRIBE_URL } from '../config';
import { getPhoto, srcset } from '../lib/flickr';
import { formatKm, formatLat, formatLatLng, routeKm } from '../lib/geo';
import { formatDate, getPosts, placeName } from '../lib/posts';

const posts = await getPosts();
const markers = await Promise.all(
  posts.map(async (post) => {
    const cover = post.coverId ? await getPhoto(post.coverId) : undefined;
    return {
      url: post.url,
      title: post.entry.data.title,
      place: post.entry.data.place,
      placeName: placeName(post.entry.data.place),
      date: formatDate(post.entry.data.date),
      isoDate: post.entry.data.date.toISOString().slice(0, 10),
      shortDate: post.entry.data.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'short', timeZone: 'UTC' }),
      day: post.day,
      lat: post.lat,
      lng: post.lng,
      thumb: cover?.thumb.src,
      // Cards are at most 20rem wide; 800px covers them on 2x screens.
      thumbSrcset: cover ? srcset(cover, 800) : undefined,
    };
  }),
);
const globeData = { posts: markers, home: HOME, accent: ACCENT };
const latest = markers.at(-1);
const km = formatKm(routeKm([HOME, ...posts]));
const dayLabel = (day: number) => `DAG ${String(day).padStart(2, '0')}`;

// The headline sets the accent phrase of the description in italic vermilion.
const accentAt = SITE_DESCRIPTION_ACCENT ? SITE_DESCRIPTION.indexOf(SITE_DESCRIPTION_ACCENT) : -1;
const headline =
  accentAt < 0
    ? { before: SITE_DESCRIPTION, accent: '', after: '' }
    : {
        before: SITE_DESCRIPTION.slice(0, accentAt),
        accent: SITE_DESCRIPTION_ACCENT,
        after: SITE_DESCRIPTION.slice(accentAt + SITE_DESCRIPTION_ACCENT.length),
      };
---

<Base>
  <div class="page">
    <header class="top mono">
      <span class="name">{SITE_TITLE.toUpperCase()}</span>
      {latest && <span class="live">Dag {latest.day} · nu in {latest.placeName}</span>}
      {latest && <span class="coords">{formatLatLng(latest)}</span>}
    </header>

    <main class="grid">
      <section class="intro" aria-labelledby="headline">
        <h1 id="headline">{headline.before}{headline.accent && <em>{headline.accent}</em>}{headline.after}</h1>
        {SUBSCRIBE_URL && <a class="subscribe mono" href={SUBSCRIBE_URL}>Volgen per mail</a>}
        {
          markers.length === 0 ? (
            <p class="empty">Nog geen posts. Binnenkort meer.</p>
          ) : (
            <nav class="index" aria-label="Alle posts">
              <ol class="idx">
                {markers.toReversed().map((m) => (
                  <li>
                    <a href={m.url} data-post={m.url} aria-current={m === latest ? 'true' : undefined}>
                      <span class="d">{dayLabel(m.day)}</span>
                      <span class="p">{m.placeName}</span>
                      <span class="c">{formatLat(m.lat)}</span>
                      <time class="c" datetime={m.isoDate}>{m.shortDate}</time>
                      <span class="t">{m.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </section>

      <div class="map">
        <div id="globe" role="region" aria-label="Wereldkaart met posts"></div>
        <p class="legend mono">{markers.length} {markers.length === 1 ? 'post' : 'posts'} · {km} km<span class="drag"> · sleep om te draaien</span></p>
        <aside id="preview" class="card" hidden aria-live="polite"></aside>
      </div>
    </main>
  </div>

  <script id="globe-data" type="application/json" set:html={JSON.stringify(globeData)} />
</Base>

<script>
  import { initGlobe } from '../scripts/globe';
  initGlobe();
</script>

<style>
  .page {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100dvh;
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 2.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .live::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--verm);
    vertical-align: 1px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    min-height: 0;
  }

  .intro {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 2.5rem;
    border-right: 1px solid var(--line);
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    font: 400 clamp(2.75rem, 4.6vw, 4rem) / 0.98 var(--display);
    letter-spacing: -0.03em;
    text-wrap: balance;
    animation: rise 300ms ease-out both;
  }

  h1 em {
    color: var(--verm);
    font-style: italic;
  }

  .subscribe {
    margin-top: 1rem;
    color: var(--ink);
  }

  .index {
    display: flex;
    flex-direction: column;
    min-height: 0;
    margin-top: 2rem;
  }

  .idx {
    margin: 0;
    padding: 0;
    overflow: auto;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .idx a {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 2px 1rem;
    align-items: baseline;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .idx a:focus-visible {
    outline-offset: -2px;
  }

  .d,
  .c {
    color: var(--mute);
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
  }

  .c {
    font-size: 0.75rem;
  }

  .p {
    font: 500 1.375rem / 1.15 var(--display);
    transition: color 150ms ease;
  }

  .idx a:hover .p,
  .idx a:focus-visible .p,
  .idx a[aria-current='true'] .p {
    color: var(--verm-tekst);
  }

  .t {
    grid-column: 2 / 4;
    color: var(--mute);
    font-size: 1rem;
  }

  .empty {
    margin: 2rem 0 0;
    color: var(--mute);
  }

  .map {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  #globe {
    position: absolute;
    inset: 0;
    background: var(--paper);
  }

  .legend {
    position: absolute;
    left: 1.75rem;
    bottom: 1.5rem;
    margin: 0;
    padding: 0.125rem 0.375rem;
    background: var(--paper);
    color: var(--mute);
    pointer-events: none;
  }

  /* The drag hint only once there is a globe to drag. */
  .map:not(:global(.ready)) .drag {
    display: none;
  }

  @media (max-width: 699.98px) {
    .page {
      display: block;
      height: auto;
    }

    .top {
      padding: 0.875rem 1.25rem;
    }

    .coords {
      display: none;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .map {
      order: -1;
      height: 300px;
      border-bottom: 1px solid var(--line);
    }

    .intro {
      padding: 1.375rem 1.25rem 2.5rem;
      border-right: 0;
    }

    h1 {
      font-size: 2.25rem;
    }

    .index {
      margin-top: 1.25rem;
    }

    .idx {
      overflow: visible;
    }

    .idx a {
      grid-template-columns: 3.6rem minmax(0, 1fr);
    }

    .c {
      display: none;
    }

    .t {
      grid-column: 2;
    }

    .legend {
      left: 1.25rem;
      right: 2.75rem;
      bottom: 0.875rem;
      font-size: 0.75rem;
    }
  }

  :global(.globe-rim) {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border: 1.2px solid var(--ink);
    border-radius: 50%;
    pointer-events: none;
  }

  .card {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    width: min(20rem, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    overflow: auto;
    background: var(--paper);
    border: 1px solid var(--ink);
    animation: rise 200ms ease-out;
  }

  :global(.card img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-bottom: 1px solid var(--ink);
  }

  @media (max-width: 699.98px) {
    :global(.card img) {
      display: none;
    }
  }

  :global(.card .content) {
    padding: 0.875rem 1rem 1rem;
  }

  :global(.card .label) {
    display: block;
    color: var(--verm-tekst);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  :global(.card h2) {
    margin: 0.35rem 0 0.5rem;
    font: 400 1.5rem / 1.1 var(--display);
    letter-spacing: -0.015em;
  }

  :global(.card .date) {
    display: block;
    margin-bottom: 0.875rem;
    color: var(--mute);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  :global(.card .read) {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  :global(.card ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  :global(.card li) {
    border-bottom: 1px solid var(--line);
  }

  :global(.card li a) {
    display: block;
    padding: 0.6rem 0;
    color: var(--ink);
    text-decoration: none;
  }

  :global(.card li a:hover) {
    color: var(--verm-tekst);
  }

  :global(.card .close) {
    float: right;
    margin: -0.25rem -0.25rem 0 0;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--mute);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(.pulse) {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 50%;
    /* The darker accent keeps the paper-coloured day number at 4.7:1. */
    background: var(--verm-tekst);
    border: 1.6px solid var(--verm);
    color: var(--paper);
    font: 500 11px/1 var(--mono);
    cursor: pointer;
    transition: scale 150ms ease;
  }

  :global(.pulse:hover),
  :global(.pulse:focus-visible) {
    scale: 1.25;
  }

  :global(.pulse::after) {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--verm);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.pulse::after) {
      animation: none;
    }
  }
</style>
