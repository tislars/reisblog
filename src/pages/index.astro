---
import 'maplibre-gl/dist/maplibre-gl.css';
import Base from '../layouts/Base.astro';
import { ACCENT, HOME, SITE_TITLE, SUBSCRIBE_URL } from '../config';
import { getPhoto } from '../lib/flickr';
import { formatDate, getPosts, withBase } from '../lib/posts';

const posts = await getPosts();
const markers = await Promise.all(
  posts.map(async (post) => ({
    url: post.url,
    title: post.entry.data.title,
    place: post.entry.data.place,
    date: formatDate(post.entry.data.date),
    lat: post.lat,
    lng: post.lng,
    thumb: post.coverId ? (await getPhoto(post.coverId)).thumb.src : undefined,
  })),
);
const globeData = { posts: markers, home: HOME, accent: ACCENT };
---

<Base theme="dark">
  <h1 class="sr-only">{SITE_TITLE}</h1>
  <div id="globe" role="region" aria-label="Wereldkaart met posts"></div>

  <aside id="preview" class="card" hidden aria-live="polite"></aside>

  <section class="timeline" aria-label="Alle posts">
    <header>
      <span class="title">{SITE_TITLE}</span>
      <span class="links">
        <a href={withBase('rss.xml')}>RSS</a>
        {SUBSCRIBE_URL && <a href={SUBSCRIBE_URL}>Volgen per mail</a>}
      </span>
    </header>
    {
      posts.length === 0 ? (
        <p class="empty">Nog geen posts. Binnenkort meer.</p>
      ) : (
        <ol>
          {[...markers].reverse().map((m) => (
            <li>
              <a href={m.url} data-fly={m.url}>
                <span class="place">{m.place}</span>
                <span class="post-title">{m.title}</span>
                <span class="date">{m.date}</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <script id="globe-data" type="application/json" set:html={JSON.stringify(globeData)} />
</Base>

<script>
  import { initGlobe } from '../scripts/globe';
  initGlobe();
</script>

<style>
  #globe {
    position: fixed;
    inset: 0;
  }

  .card {
    position: fixed;
    z-index: 2;
    left: 50%;
    top: max(1rem, env(safe-area-inset-top));
    transform: translateX(-50%);
    width: min(22rem, calc(100% - 2rem));
    max-height: 50dvh;
    overflow: auto;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.5);
  }

  .timeline {
    position: fixed;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 0 max(0.75rem, env(safe-area-inset-bottom));
    background: linear-gradient(transparent, rgb(11 11 13 / 0.92) 30%);
    pointer-events: none;
  }

  .timeline > * {
    pointer-events: auto;
  }

  .timeline header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 1rem 0.5rem;
  }

  .title {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .links a {
    font-size: 0.85rem;
    margin-left: 1rem;
    text-decoration: none;
  }

  .timeline ol {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .timeline li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .timeline li a {
    display: grid;
    width: 11rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
  }

  .timeline li a:hover,
  .timeline li a[aria-current='true'] {
    border-color: var(--accent);
  }

  .place,
  :global(.card .place) {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-title {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .date,
  .empty {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .empty {
    padding: 0 1rem;
    margin: 0;
  }

  :global(.pulse) {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid #fff;
    cursor: pointer;
    padding: 0;
  }

  :global(.pulse::after) {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.pulse::after) {
      animation: none;
    }
  }

  :global(.card img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.75rem 0.75rem 0 0;
  }

  :global(.card .content) {
    padding: 0.9rem 1rem 1rem;
  }

  :global(.card h2) {
    font-size: 1.15rem;
    margin: 0.2rem 0 0.75rem;
  }

  :global(.card ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.card li + li) {
    border-top: 1px solid var(--line);
  }

  :global(.card li a) {
    display: block;
    padding: 0.6rem 0;
    color: var(--fg);
    text-decoration: none;
  }

  :global(.card .read) {
    font-weight: 600;
    text-decoration: none;
  }

  :global(.card .close) {
    float: right;
    background: none;
    border: 0;
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
